{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harbour & Bay",
  "version": "1.0.0",
  "identifier": "com.honeybunny.zinemaker",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Harbour & Bay",
        "width": 1200,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#123328",
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "category": "GraphicsAndDesign",
    "shortDescription": "A little offline zine maker.",
    "longDescription": "Harbour & Bay — one sheet, one cut, a whole book. An offline photo-zine maker."
  }
}
